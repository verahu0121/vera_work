PORT=8001
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string
# Required in production: the public, canonical origin (no trailing slash).
APP_ORIGIN=https://your-portfolio.example
# Set only to the addresses of your own reverse proxy, never to all clients.
# TRUST_PROXY=127.0.0.1,::1
# Only required when creating a brand-new installation without existing password hashes.
# INITIAL_PLATFORM_PASSWORD=choose-a-unique-password
# INITIAL_ADMIN_PASSWORD=choose-a-different-unique-password
S3_ENDPOINT=https://dev-minio.superhk.cloud
S3_BUCKET=blogtest
S3_ACCESS_KEY_ID=blogtest-dev
S3_SECRET_ACCESS_KEY=your-secret-here
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
VITE_BACKEND_URL=http://127.0.0.1:8001
